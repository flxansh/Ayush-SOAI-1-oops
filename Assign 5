#include<iostream>
using namespace std;
class STUDENT
{
  public:
    string student_name;
    float per;
    int passing_year;
    int enrollmentno;

   STUDENT(string student_name , float per,int passing_year, int enrollmentno)
   {
     this->student_name=student_name;
     this->per= per;
     this->passing_year = passing_year;
     this->enrollmentno= enrollmentno;
   }
   void student()
{
 cout<<"\n \t !!!!!! Student Details !!!!!! \t \n"<<"\n";
 cout<<"Student Name: "<<student_name<<"\n";
 cout<<"Student Percentage: "<<per<<"%"<<"\n";
 cout<<"Student Passing Year: "<<passing_year<<"\n";
 cout<<"Student Enrollment No.: "<<enrollmentno<<"\n";
}
};
int main()
{
  STUDENT S1("Bheem", 54.3, 1999,473892);
  STUDENT S2("Astha",87.56,2001,75192);
  S1.student();
  S2.student();
  return 0;
}
